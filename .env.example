# Get a free key at https://aistudio.google.com/app/apikey (Gemini free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ports (override if 8000/8001 are busy on your machine)
GUARDIAN_PORT=8000
BACKEND_PORT=8001
# Where safe traffic is forwarded (defaults to http://127.0.0.1:$BACKEND_PORT)
# UPSTREAM_URL=http://127.0.0.1:8001

# If no GEMINI_API_KEY is set, the guard falls back to a local heuristic analyser
# so the POC is still fully runnable/testable offline.
LLM_TIMEOUT_SECONDS=15
